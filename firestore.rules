rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cuenta de la docente (Firebase Authentication).
    function isTeacher() {
      return request.auth != null
        && request.auth.token.email in ['zxc.navi2018@gmail.com'];
    }

    function validStudent(d) {
      return d.keys().hasOnly(['dni', 'name', 'section', 'grade', 'createdAt'])
        && d.keys().hasAll(['dni', 'name', 'section', 'grade', 'createdAt'])
        && d.dni is string && d.dni.matches('[0-9]{8}')
        && d.name is string && d.name.size() >= 3 && d.name.size() <= 60
        && d.section in ['A', 'B', 'C', 'D', 'E', 'F']
        && d.grade in ['5to', '6to']
        && d.createdAt is timestamp;
    }

    function validResult(d) {
      return d.keys().hasOnly(['unit', 'unitNum', 'session', 'grade', 'section', 'name', 'student', 'dni', 'score', 'total', 'answers', 'createdAt'])
        && d.keys().hasAll(['unit', 'unitNum', 'session', 'grade', 'section', 'name', 'student', 'dni', 'score', 'total', 'answers', 'createdAt'])
        && d.unit is string && d.unit.size() <= 20
        && d.unitNum is string && d.unitNum.size() <= 10
        && d.session is int && d.session >= 1 && d.session <= 99
        && d.grade in ['5to', '6to']
        && d.section in ['A', 'B', 'C', 'D', 'E', 'F']
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.student is string && d.student.matches('k[0-9a-f]{20}')
        && d.dni is string && d.dni.matches('[0-9]{8}')
        && d.total is int && d.total >= 1 && d.total <= 20
        && d.score is int && d.score >= 0 && d.score <= d.total
        && d.answers is list && d.answers.size() == d.total
        && d.createdAt is timestamp;
    }

    // Cuentas de estudiantes: el id sale del DNI (cifrado), así que solo quien
    // conoce el DNI puede abrir su cuenta. Solo la docente ve la lista completa.
    match /students/{id} {
      allow get: if true;
      // Solo el docente crea cuentas (desde su lista de Excel).
      allow create: if isTeacher() && id.matches('k[0-9a-f]{20}') && validStudent(request.resource.data);
      allow list, update, delete: if isTeacher();
    }

    // Resultados: uno por estudiante y sesión, no se pueden cambiar.
    // El estudiante puede ver el suyo (necesita su id); solo la docente ve todos o borra.
    match /exitTickets/{id} {
      allow create: if validResult(request.resource.data)
        && id == request.resource.data.unit + '-s' + string(request.resource.data.session) + '-' + request.resource.data.student
        && get(/databases/$(database)/documents/students/$(request.resource.data.student)).data.dni == request.resource.data.dni;
      allow get: if id.matches('.*-k[0-9a-f]{20}') || isTeacher();
      allow list, delete: if isTeacher();
      allow update: if false;
    }

    // Ropa de Moli de cada estudiante (tienda). Se guarda con el id de su cuenta.
    match /closets/{id} {
      allow get: if true;
      allow create, update: if id.matches('k[0-9a-f]{20}')
        && exists(/databases/$(database)/documents/students/$(id))
        && request.resource.data.keys().hasOnly(['owned', 'equipped', 'codes', 'updatedAt'])
        && (!('codes' in request.resource.data) || (request.resource.data.codes is list && request.resource.data.codes.size() <= 100))
        && request.resource.data.owned is list && request.resource.data.owned.size() <= 60
        && request.resource.data.equipped is list && request.resource.data.equipped.size() <= 10
        && request.resource.data.updatedAt is timestamp;
      allow list, delete: if isTeacher();
    }

    // Códigos de estrellas: ya no existen. Solo la docente puede borrar los que quedaron.
    match /redemptions/{code} {
      allow list, delete: if isTeacher();
    }

    // Ranking de estrellas: ya no existe. Solo la docente puede borrar lo que quedó.
    match /ranking/{id} {
      allow list, delete: if isTeacher();
    }

    // Portada: título, bimestre y unidades visibles. Todos la leen; solo la docente la cambia.
    match /config/{id} {
      allow get: if true;
      allow create, update: if isTeacher() && id == 'vs'
        && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
        && request.resource.data.data is string && request.resource.data.data.size() <= 300000
        && request.resource.data.updatedAt is timestamp;
      allow create, update: if isTeacher() && id == 'practice'
        && request.resource.data.keys().hasOnly(['data', 'ids', 'updatedAt'])
        && request.resource.data.data is string && request.resource.data.data.size() <= 80000
        && request.resource.data.ids is list && request.resource.data.ids.size() <= 300
        && request.resource.data.updatedAt is timestamp;
      // Contenido de la página (textos, sesiones, preguntas y lista de fichas) que la docente edita y publica.
      allow create, update: if isTeacher() && id == 'content'
        && request.resource.data.keys().hasOnly(['data', 'savedAt', 'updatedAt'])
        && request.resource.data.data is string && request.resource.data.data.size() <= 900000
        && request.resource.data.savedAt is int
        && request.resource.data.updatedAt is timestamp;
      // Mensajitos aprobados que salen en el chat del Inicio (los pone la docente).
      allow create, update: if isTeacher() && id == 'chat'
        && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
        && request.resource.data.data is string && request.resource.data.data.size() <= 20000
        && request.resource.data.updatedAt is timestamp;
      allow create, update: if isTeacher() && id == 'site'
        && request.resource.data.keys().hasOnly(['title', 'bimestre', 'hidden', 'lbl', 'tch', 'tchN', 'areas', 'updatedAt'])
        && (!('tch' in request.resource.data) || (request.resource.data.tch is list && request.resource.data.tch.size() <= 40))
        && (!('tchN' in request.resource.data) || (request.resource.data.tchN is map && request.resource.data.tchN.size() <= 40))
        && (!('areas' in request.resource.data) || (request.resource.data.areas is string && request.resource.data.areas.size() <= 3000))
        && (!('lbl' in request.resource.data) || (request.resource.data.lbl is string && request.resource.data.lbl.size() <= 30))
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 40
        && request.resource.data.bimestre is int && request.resource.data.bimestre >= 1 && request.resource.data.bimestre <= 4
        && request.resource.data.hidden is list && request.resource.data.hidden.size() <= 20
        && request.resource.data.updatedAt is timestamp;
      // Misiones (Exit tickets y tareas que crea la docente). Todos las leen; solo ella las cambia.
      allow create, update: if isTeacher() && id == 'mis'
        && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
        && request.resource.data.data is string && request.resource.data.data.size() <= 300000
        && request.resource.data.updatedAt is timestamp;
      // Misiones (actividades que crea la docente). Todos las leen; solo ella las cambia.
      allow create, update: if isTeacher() && id == 'mis1'
        && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
        && request.resource.data.data is string && request.resource.data.data.size() <= 400000
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isTeacher();
    }

    // Mensajitos de los estudiantes para el chat del Inicio: cada estudiante deja uno (máx. 8 palabras),
    // llega «pendiente» a la docente y solo ella lo aprueba o lo rechaza.
    match /notes/{id} {
      allow get: if true;
      allow list, delete: if isTeacher();
      allow create, update: if id.matches('k[0-9a-f]{20}')
        && request.resource.data.keys().hasOnly(['n', 'sec', 'dni', 'text', 'status', 'at'])
        && request.resource.data.n is string && request.resource.data.n.size() > 0 && request.resource.data.n.size() <= 30
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 80
        && request.resource.data.status == 'pending'
        && request.resource.data.at is timestamp
        && get(/databases/$(database)/documents/students/$(id)).data.dni == request.resource.data.dni
        && get(/databases/$(database)/documents/students/$(id)).data.section == request.resource.data.sec;
      allow update: if isTeacher()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['ok', 'no'];
    }

    // 📦 Caja de actividades (sesiones adicionales): cada estudiante sube su trabajo de cada actividad.
    // «tasks» guarda los datos (id = extra-s<sesión>-a<actividad>-<cuenta>); «taskFiles» el archivo en trozos.
    match /tasks/{id} {
      allow get: if id.matches('extra-s[0-9]{1,2}-a[0-9]{1,2}-k[0-9a-f]{20}') || isTeacher();
      allow list, delete: if isTeacher();
      allow create, update: if id.matches('extra-s[0-9]{1,2}-a[0-9]{1,2}-k[0-9a-f]{20}')
        && request.resource.data.keys().hasOnly(['session', 'act', 'student', 'n', 'sec', 'dni', 'fname', 'ftype', 'size', 'parts', 'url', 'at'])
        && request.resource.data.keys().hasAll(['session', 'act', 'student', 'n', 'sec', 'dni', 'fname', 'ftype', 'size', 'parts', 'at'])
        && request.resource.data.session is int && request.resource.data.session >= 1 && request.resource.data.session <= 50
        && request.resource.data.act is int && request.resource.data.act >= 1 && request.resource.data.act <= 20
        && request.resource.data.student is string && request.resource.data.student.matches('k[0-9a-f]{20}')
        && id == 'extra-s' + string(request.resource.data.session) + '-a' + string(request.resource.data.act) + '-' + request.resource.data.student
        && request.resource.data.n is string && request.resource.data.n.size() > 0 && request.resource.data.n.size() <= 60
        && request.resource.data.fname is string && request.resource.data.fname.size() > 0 && request.resource.data.fname.size() <= 80
        && request.resource.data.ftype is string && request.resource.data.ftype.size() <= 100
        && request.resource.data.size is int && request.resource.data.size >= 0 && request.resource.data.size <= 8000000
        && request.resource.data.parts is int && request.resource.data.parts >= 0 && request.resource.data.parts <= 6
        && (request.resource.data.parts >= 1
          ? !('url' in request.resource.data)
          : (request.resource.data.url is string && request.resource.data.url.size() <= 500 && request.resource.data.url.matches('https?://.+')))
        && request.resource.data.at is timestamp
        && get(/databases/$(database)/documents/students/$(request.resource.data.student)).data.dni == request.resource.data.dni
        && get(/databases/$(database)/documents/students/$(request.resource.data.student)).data.section == request.resource.data.sec;
    }
    match /taskFiles/{id} {
      allow get: if id.matches('extra-s[0-9]{1,2}-a[0-9]{1,2}-k[0-9a-f]{20}-[0-9]') || isTeacher();
      allow list, delete: if isTeacher();
      allow create, update: if id.matches('extra-s[0-9]{1,2}-a[0-9]{1,2}-k[0-9a-f]{20}-[0-5]')
        && exists(/databases/$(database)/documents/students/$(id.split('-')[3]))
        && request.resource.data.keys().hasOnly(['b64', 'at'])
        && request.resource.data.b64 is string && request.resource.data.b64.size() <= 900000
        && request.resource.data.at is timestamp;
    }

    // 🏆 Adicional completo: el estudiante lo envía una vez (con su Exit ticket y sus actividades ya subidas) «por revisar»;
    // la docente lo aprueba o lo rechaza; aprobado, el estudiante recibe las estrellas de la categoría («got» pasa a true una sola vez).
    // Revisión de las tareas de Misiones: solo la docente aprueba o rechaza; el estudiante lee la suya.
    match /mrev/{id} {
      allow get: if id.matches('extra-s50-a[0-9]{1,2}-k[0-9a-f]{20}') || isTeacher();
      allow list, delete: if isTeacher();
      allow create, update: if isTeacher() && id.matches('extra-s50-a[0-9]{1,2}-k[0-9a-f]{20}')
        && request.resource.data.keys().hasOnly(['status', 'stars', 'rv'])
        && request.resource.data.status in ['ok', 'no']
        && request.resource.data.stars is int && request.resource.data.stars >= 0 && request.resource.data.stars <= 3
        && request.resource.data.rv is timestamp;
    }
    match /xbonus/{id} {
      allow get: if id.matches('extra-s[0-9]{1,2}-k[0-9a-f]{20}') || isTeacher();
      allow list, delete: if isTeacher();
      allow create: if id.matches('extra-s[0-9]{1,2}-k[0-9a-f]{20}')
        && request.resource.data.keys().hasOnly(['session', 'student', 'n', 'sec', 'dni', 'acts', 'a', 'got', 'status', 'tier', 'stars', 'at'])
        && request.resource.data.keys().hasAll(['session', 'student', 'n', 'sec', 'dni', 'acts', 'a', 'got', 'status', 'tier', 'stars', 'at'])
        && request.resource.data.status == 'pending'
        && request.resource.data.tier in ['celestial', 'diamante', 'oro', 'plata', 'cobre']
        && request.resource.data.stars is int && request.resource.data.stars >= 0 && request.resource.data.stars <= 15
        && request.resource.data.session is int && request.resource.data.session >= 1 && request.resource.data.session <= 50
        && request.resource.data.student is string && request.resource.data.student.matches('k[0-9a-f]{20}')
        && id == 'extra-s' + string(request.resource.data.session) + '-' + request.resource.data.student
        && request.resource.data.n is string && request.resource.data.n.size() > 0 && request.resource.data.n.size() <= 60
        && request.resource.data.acts is int && request.resource.data.acts >= 1 && request.resource.data.acts <= 20
        && request.resource.data.a is int && request.resource.data.a >= 1 && request.resource.data.a <= 20
        && request.resource.data.got == false
        && request.resource.data.at is timestamp
        && get(/databases/$(database)/documents/students/$(request.resource.data.student)).data.dni == request.resource.data.dni
        && get(/databases/$(database)/documents/students/$(request.resource.data.student)).data.section == request.resource.data.sec
        && exists(/databases/$(database)/documents/tasks/$('extra-s' + string(request.resource.data.session) + '-a' + string(request.resource.data.a) + '-' + request.resource.data.student));
      // el estudiante recibe sus estrellas solo si la docente lo aprobó
      allow update: if resource.data.got == false && request.resource.data.got == true
        && resource.data.get('status', 'ok') == 'ok'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['got']);
      // si la docente lo rechazó, el estudiante lo corrige y lo envía otra vez
      allow update: if resource.data.get('status', 'ok') == 'no' && request.resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'at'])
        && request.resource.data.at is timestamp;
      // la docente aprueba o rechaza (y fija las estrellas según la categoría de la sesión)
      allow update: if isTeacher()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'tier', 'stars', 'rv'])
        && request.resource.data.status in ['ok', 'no', 'pending']
        && request.resource.data.stars is int && request.resource.data.stars >= 0 && request.resource.data.stars <= 15;
    }

    // Fichas que sube la docente, partidas en trozos de hasta 900 000 caracteres (base64).
    match /files/{id} {
      allow get: if true;
      allow create, update: if isTeacher() && id.matches('f[a-z0-9]{1,24}-[0-9]{1,2}')
        && request.resource.data.keys().hasOnly(['b64', 'updatedAt'])
        && request.resource.data.b64 is string && request.resource.data.b64.size() <= 900000
        && request.resource.data.updatedAt is timestamp;
      allow list, delete: if isTeacher();
    }

    // 🏅 Torneo: la docente crea «tourneys/current». Los estudiantes se inscriben (máximo 20 cupos),
    // envían su Exit ticket una sola vez y nadie ve resultados ajenos hasta que la docente los publica.
    function tNow() {
      return get(/databases/$(database)/documents/tourneys/current).data;
    }
    match /tourneys/{id} {
      allow get: if true;
      allow list: if isTeacher();
      allow create, update: if isTeacher() && id == 'current';
      allow delete: if isTeacher();
    }
    // Cupos públicos (nombre corto, sección y Moli) para que los compañeros vean quién participa.
    match /tslots/{id} {
      allow get, list: if true;
      allow create: if id.matches('t[a-z0-9]{4,16}_([1-9]|1[0-9]|20)')
        && tNow().status == 'open' && id.split('_')[0] == tNow().tid
        && request.resource.data.keys().hasOnly(['name', 'section', 'outfit', 'rid', 'tid', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.section is string && request.resource.data.section.size() <= 4
        && request.resource.data.outfit is list && request.resource.data.outfit.size() <= 12
        && request.resource.data.rid is string && request.resource.data.rid.size() <= 30
        && request.resource.data.tid == tNow().tid
        && request.resource.data.at is timestamp;
      allow delete: if isTeacher();
    }
    // Inscripción privada (una por estudiante): va junto con su cupo en la misma escritura.
    match /tjoin/{id} {
      allow get: if true;
      allow list, delete: if isTeacher();
      allow create: if id.matches('t[a-z0-9]{4,16}_k[0-9a-f]{20}')
        && tNow().status == 'open' && id.split('_')[0] == tNow().tid
        && exists(/databases/$(database)/documents/students/$(id.split('_')[1]))
        && request.resource.data.keys().hasOnly(['n', 'rid', 'at'])
        && request.resource.data.n is int && request.resource.data.n >= 1 && request.resource.data.n <= 20
        && !exists(/databases/$(database)/documents/tslots/$(tNow().tid + '_' + string(request.resource.data.n)))
        && getAfter(/databases/$(database)/documents/tslots/$(tNow().tid + '_' + string(request.resource.data.n))).data.rid == request.resource.data.rid
        && request.resource.data.at is timestamp;
    }
    // Respuestas del torneo: un solo intento; solo la docente puede listarlas.
    match /tres/{id} {
      allow get: if true;
      allow list, delete: if isTeacher();
      allow create: if id.matches('t[a-z0-9]{4,16}_k[0-9a-f]{20}')
        && tNow().status == 'open' && id.split('_')[0] == tNow().tid
        && exists(/databases/$(database)/documents/tjoin/$(id))
        && request.resource.data.keys().hasOnly(['score', 'total', 'ms', 'answers', 'at'])
        && request.resource.data.total is int && request.resource.data.total >= 1 && request.resource.data.total <= 20
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= request.resource.data.total
        && request.resource.data.ms is int && request.resource.data.ms > 0 && request.resource.data.ms < 3600000
        && request.resource.data.answers is list && request.resource.data.answers.size() == request.resource.data.total
        && request.resource.data.at is timestamp;
    }
    // ✉️ Correo: la docente envía premios; el estudiante solo marca como reclamados los que le enviaron.
    match /mail/{id} {
      allow get: if true;
      allow list, delete: if isTeacher();
      allow create, update: if isTeacher() && id.matches('k[0-9a-f]{20}')
        && request.resource.data.keys().hasOnly(['items', 'ids', 'claimed', 'updatedAt'])
        && request.resource.data.items is string && request.resource.data.items.size() <= 30000
        && request.resource.data.ids is list && request.resource.data.ids.size() <= 100
        && request.resource.data.claimed is list
        && request.resource.data.updatedAt is timestamp;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed', 'updatedAt'])
        && request.resource.data.claimed is list && request.resource.data.claimed.size() <= resource.data.ids.size()
        && request.resource.data.claimed.hasAll(resource.data.claimed)
        && request.resource.data.claimed.hasOnly(resource.data.ids)
        && request.resource.data.updatedAt is timestamp;
    }

    // Regalo diario: una vez por día (hora de Perú). La racha sube de 1 en 1 hasta 15 (si faltas un día vuelve a 1).
    // Cada 3 días de racha (días 3, 6, 9, 12 y 15) se ganan 6 estrellas; el día 15 además puede traer un objeto básico.
    function peruDay() {
      return math.floor((request.time.toMillis() - 18000000) / 86400000);
    }
    function basicGift(id) {
      return id in ['a-badge', 'b-track', 'f-guard-c', 'f-guard-t', 'b-guard', 'b-jersey', 'b-gi', 'fx-notes', 'w-violin', 'tophat', 'grad', 'hl-antenna', 'hl-cat', 'hl-horns', 'e-pink', 'e-violet', 'e-gold', 'e-anime', 'e-heart', 'e-star', 'h-bronze', 'h-silver', 'b-belt', 'b-plate', 'sh-radar', 'sh-cannon', 'wand', 'sword', 'shield', 'arco', 'w-blaster', 'at-claw', 'at-drill', 'bk-cape', 'bk-vampire', 'bk-jet', 'fx-sparks', 'a-innova', 'a-emblem', 'a-scarf', 'a-sphere', 'pt-drone', 'pt-crew', 'pt-dog', 'goggles', 'shades'];
    }
    function validDaily(d) {
      return d.keys().hasOnly(['day', 'streak', 'total', 'gifts', 'updatedAt'])
        && d.day is int && d.day == peruDay()
        && d.streak is int && d.streak >= 1 && d.streak <= 15
        && d.total is int && d.total >= 0 && d.total <= 5000
        && d.gifts is list && d.gifts.size() <= 60
        && d.updatedAt is timestamp;
    }
    function dailyPrize(d, old, oldGifts) {
      return d.total == old + (d.streak % 3 == 0 ? 6 : 0)
        && (d.gifts == oldGifts
          || (d.streak == 15 && d.gifts.size() == oldGifts.size() + 1 && d.gifts.hasAll(oldGifts) && basicGift(d.gifts[d.gifts.size() - 1])));
    }
    match /daily/{id} {
      allow get: if true;
      allow create: if id.matches('k[0-9a-f]{20}')
        && exists(/databases/$(database)/documents/students/$(id))
        && validDaily(request.resource.data)
        && request.resource.data.streak == 1 && dailyPrize(request.resource.data, 0, []);
      allow update: if validDaily(request.resource.data)
        && request.resource.data.day > resource.data.day
        && request.resource.data.streak == ((request.resource.data.day == resource.data.day + 1 && resource.data.streak < 15) ? resource.data.streak + 1 : 1)
        && dailyPrize(request.resource.data, resource.data.total, resource.data.gifts);
      allow list, delete: if isTeacher();
    }

    // Más estrellas: ejercicios de práctica completados (cada uno da 2 estrellas una sola vez).
    match /practice/{id} {
      allow get: if true;
      allow create: if id.matches('k[0-9a-f]{20}')
        && exists(/databases/$(database)/documents/students/$(id))
        && request.resource.data.keys().hasOnly(['done', 'updatedAt'])
        && request.resource.data.done is list && request.resource.data.done.size() <= 300
        && request.resource.data.done.hasOnly(get(/databases/$(database)/documents/config/practice).data.ids)
        && request.resource.data.updatedAt is timestamp;
      allow update: if request.resource.data.keys().hasOnly(['done', 'updatedAt'])
        && request.resource.data.done is list && request.resource.data.done.size() <= 300
        && request.resource.data.done.hasAll(resource.data.done)
        && request.resource.data.done.hasOnly(get(/databases/$(database)/documents/config/practice).data.ids)
        && request.resource.data.updatedAt is timestamp;
      allow list, delete: if isTeacher();
    }

    // Duelos VS: un estudiante espera, otro se une; los dos escriben solo sus puntos.
    function validDuel(d) {
      return d.keys().hasOnly(['status', 'p1', 'n1', 'o1', 'p2', 'n2', 'o2', 'qs', 's1', 'a1', 's2', 'a2', 'hb', 'createdAt', 'updatedAt'])
        && d.status in ['waiting', 'ready', 'cancel']
        && d.p1 is string && d.p1.matches('r[0-9a-f]{20}')
        && d.p2 is string && (d.p2 == '' || d.p2.matches('r[0-9a-f]{20}'))
        && d.n1 is string && d.n1.size() <= 40 && d.n2 is string && d.n2.size() <= 40
        && d.o1 is string && d.o1.size() <= 800 && d.o2 is string && d.o2.size() <= 800
        && d.qs is string && d.qs.size() <= 20000
        && d.s1 is int && d.s1 >= 0 && d.s1 <= 1000 && d.a1 is int && d.a1 >= 0 && d.a1 <= 5
        && d.s2 is int && d.s2 >= 0 && d.s2 <= 1000 && d.a2 is int && d.a2 >= 0 && d.a2 <= 5
        && d.hb is timestamp && d.createdAt is timestamp && d.updatedAt is timestamp;
    }
    match /duels/{id} {
      allow get: if true;
      allow list: if request.query.limit <= 10 || isTeacher();
      allow create: if id.matches('d[0-9a-z]{6,30}') && validDuel(request.resource.data)
        && request.resource.data.status == 'waiting' && request.resource.data.p2 == ''
        && request.resource.data.s1 == 0 && request.resource.data.a1 == 0 && request.resource.data.s2 == 0 && request.resource.data.a2 == 0;
      allow update: if validDuel(request.resource.data)
        && request.resource.data.p1 == resource.data.p1 && request.resource.data.qs == resource.data.qs
        && ((resource.data.status == 'waiting' && request.resource.data.status in ['waiting', 'cancel']
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'hb', 'updatedAt']))
          || (resource.data.status == 'waiting' && request.resource.data.status == 'ready'
              && request.resource.data.p2 != '' && request.resource.data.p2 != resource.data.p1
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'p2', 'n2', 'o2', 'hb', 'updatedAt']))
          || (resource.data.status == 'ready' && request.resource.data.status == 'ready'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['s1', 'a1', 's2', 'a2', 'updatedAt'])
              && request.resource.data.a1 >= resource.data.a1 && request.resource.data.a2 >= resource.data.a2
              && request.resource.data.s1 >= resource.data.s1 && request.resource.data.s2 >= resource.data.s2));
      allow delete: if isTeacher();
    }

    // Duelos en equipo (2 vs 2 o 3 vs 3): equipo A = jugadores 1..m, equipo B = jugadores m+1..2m.
    // "bot" ocupa un lugar vacío (Moli Bot) cuando faltan compañeros. En 2 vs 2 los lugares 5 y 6 quedan vacíos.
    function p2v2(x) { return x is string && (x == '' || x == 'bot' || x.matches('r[0-9a-f]{20}')); }
    function sc2v2(s, a) { return s is int && s >= 0 && s <= 1000 && a is int && a >= 0 && a <= 5; }
    function nm2v2(n, o) { return n is string && n.size() <= 40 && o is string && o.size() <= 800; }
    function validDuel2(d) {
      return d.keys().hasOnly(['status', 'm', 'room', 'p1', 'n1', 'o1', 'p2', 'n2', 'o2', 'p3', 'n3', 'o3', 'p4', 'n4', 'o4',
          'p5', 'n5', 'o5', 'p6', 'n6', 'o6', 'qs',
          's1', 'a1', 's2', 'a2', 's3', 'a3', 's4', 'a4', 's5', 'a5', 's6', 'a6', 'hb', 'createdAt', 'updatedAt'])
        && d.status in ['waiting', 'ready', 'cancel'] && d.m in [2, 3]
        && (!('room' in d) || d.room is bool)
        && d.p1 is string && d.p1.matches('r[0-9a-f]{20}') && p2v2(d.p2) && p2v2(d.p3) && p2v2(d.p4) && p2v2(d.p5) && p2v2(d.p6)
        && (d.m == 3 || (d.p5 == '' && d.p6 == ''))
        && nm2v2(d.n1, d.o1) && nm2v2(d.n2, d.o2) && nm2v2(d.n3, d.o3) && nm2v2(d.n4, d.o4) && nm2v2(d.n5, d.o5) && nm2v2(d.n6, d.o6)
        && d.qs is string && d.qs.size() <= 30000
        && sc2v2(d.s1, d.a1) && sc2v2(d.s2, d.a2) && sc2v2(d.s3, d.a3) && sc2v2(d.s4, d.a4) && sc2v2(d.s5, d.a5) && sc2v2(d.s6, d.a6)
        && d.hb is timestamp && d.createdAt is timestamp && d.updatedAt is timestamp;
    }
    match /duels2/{id} {
      allow get: if true;
      allow list: if request.query.limit <= 10 || isTeacher();
      allow create: if id.matches('q[0-9a-z]{6,30}') && validDuel2(request.resource.data)
        && request.resource.data.status == 'waiting'
        && request.resource.data.p2 == '' && request.resource.data.p3 == '' && request.resource.data.p4 == ''
        && request.resource.data.p5 == '' && request.resource.data.p6 == ''
        && request.resource.data.s1 == 0 && request.resource.data.s2 == 0 && request.resource.data.s3 == 0
        && request.resource.data.s4 == 0 && request.resource.data.s5 == 0 && request.resource.data.s6 == 0;
      allow update: if validDuel2(request.resource.data)
        && request.resource.data.p1 == resource.data.p1 && request.resource.data.qs == resource.data.qs
        && request.resource.data.m == resource.data.m
        && ((resource.data.status == 'waiting'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'p2', 'n2', 'o2', 'p3', 'n3', 'o3',
                  'p4', 'n4', 'o4', 'p5', 'n5', 'o5', 'p6', 'n6', 'o6', 'hb', 'updatedAt']))
          || (resource.data.status == 'ready' && request.resource.data.status == 'ready'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['s1', 'a1', 's2', 'a2', 's3', 'a3',
                  's4', 'a4', 's5', 'a5', 's6', 'a6', 'updatedAt'])
              && request.resource.data.a1 >= resource.data.a1 && request.resource.data.a2 >= resource.data.a2
              && request.resource.data.a3 >= resource.data.a3 && request.resource.data.a4 >= resource.data.a4
              && request.resource.data.a5 >= resource.data.a5 && request.resource.data.a6 >= resource.data.a6));
      allow delete: if isTeacher();
    }

    // Misión 01: avance de cada estudiante (errores e intentos por actividad). Solo la docente ve la lista.
    // Control remoto: "p-<cuenta>" guarda el canal de cada docente (solo docente);
    // "c-<32 hex>" es el canal secreto que leen y escriben la laptop y el celular.
    // Contraseña de 4 números de cada administrador (la crea él mismo la primera vez que entra).
    // Nadie puede leerla: solo se comprueba intentando una escritura con la misma huella.
    match /apin/{id} {
      allow get, list: if false;
      allow create: if id.matches('r[0-9a-f]{20}')
        && id in get(/databases/$(database)/documents/config/site).data.tch
        && existsAfter(/databases/$(database)/documents/apinx/$(id))
        && request.resource.data.keys().hasOnly(['p', 'at'])
        && request.resource.data.p is string && request.resource.data.p.matches('[0-9a-f]{64}')
        && request.resource.data.at is timestamp;
      allow update: if request.resource.data.keys().hasOnly(['p', 'at'])
        && request.resource.data.p == resource.data.p
        && request.resource.data.at is timestamp;
      allow delete: if isTeacher();
    }
    // Marca pública: solo dice si el administrador ya creó su contraseña.
    match /apinx/{id} {
      allow get: if true;
      allow list: if isTeacher();
      allow create: if id.matches('r[0-9a-f]{20}')
        && existsAfter(/databases/$(database)/documents/apin/$(id))
        && request.resource.data.keys().hasOnly(['at'])
        && request.resource.data.at is timestamp;
      allow update: if false;
      allow delete: if isTeacher();
    }

    match /remote/{id} {
      // p- de 32 caracteres: se calcula con el DNI y la contraseña de cada docente (nadie más puede adivinarlo).
      allow get: if (isTeacher() && id.matches('p-k[0-9a-f]{20}')) || id.matches('[cs]-[0-9a-f]{32}') || id.matches('p-[0-9a-f]{32}');
      allow create, update: if id.matches('p-[0-9a-f]{32}')
        && request.resource.data.keys().hasOnly(['c', 'at'])
        && request.resource.data.c is string && request.resource.data.c.matches('[0-9a-f]{32}')
        && request.resource.data.at is timestamp;
      allow create, update: if isTeacher() && id.matches('p-k[0-9a-f]{20}')
        && request.resource.data.keys().hasOnly(['c', 'at'])
        && request.resource.data.c is string && request.resource.data.c.matches('[0-9a-f]{32}');
      // c-: órdenes del celular. s-: estado de la laptop.
      allow create, update: if id.matches('c-[0-9a-f]{32}')
        && request.resource.data.keys().hasOnly(['cmd', 'arg', 'seq', 'at'])
        && request.resource.data.cmd is string && request.resource.data.cmd.size() <= 10
        && request.resource.data.arg is string && request.resource.data.arg.size() <= 60
        && request.resource.data.seq is int;
      allow create, update: if id.matches('s-[0-9a-f]{32}')
        && request.resource.data.keys().hasOnly(['st', 'cfg', 'at'])
        && (!('st' in request.resource.data) || (request.resource.data.st is string && request.resource.data.st.size() <= 2000))
        && (!('cfg' in request.resource.data) || (request.resource.data.cfg is string && request.resource.data.cfg.size() <= 200));
    }

    match /mision/{id} {
      allow get: if true;
      allow list, delete: if isTeacher();
      allow create, update: if id.matches('m1-k[0-9a-f]{20}')
        && exists(/databases/$(database)/documents/students/$(id.split('-')[1]))
        && request.resource.data.keys().hasOnly(['p', 'n', 'sec', 'at'])
        && request.resource.data.p is string && request.resource.data.p.size() <= 4000
        && request.resource.data.n is string && request.resource.data.n.size() <= 60
        && request.resource.data.sec in ['A', 'B', 'C', 'D', 'E', 'F']
        && request.resource.data.at is timestamp;
    }

    // Marcas de la versión anterior (solo para que la docente pueda limpiarlas).
    match /exitTicketsDone/{id} {
      allow get: if true;
      allow list, delete: if isTeacher();
      allow create, update: if false;
    }
  }
}
